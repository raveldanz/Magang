* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# GitHub Linguist Overrides (Ignore scripts & any python files from language stats)
*.py linguist-detectable=false
*.py linguist-vendored
scripts/** linguist-vendored

# Institutional Memory Git Merge Strategy (Auto-union append without conflict)
.antigravity/memory/learnings.md merge=union

# Berkas batch Windows harus CRLF agar label goto terbaca
*.bat text eol=crlf
BACA_DULU.txt text eol=crlf
