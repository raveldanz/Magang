# ==============================================================================
# Multi-Agent Workflow Configuration (.env.agents)
# ==============================================================================
# Copy this file to .env.agents and insert your actual API keys.
# DO NOT commit .env.agents to version control (.gitignore has been updated).

# --- Anthropic (Claude Code & Aider Claude Models) ---
ANTHROPIC_API_KEY=

# --- DeepSeek (Cost-effective coding model for Aider) ---
DEEPSEEK_API_KEY=

# --- OpenAI (GPT-4o, o1, o3-mini for Aider) ---
OPENAI_API_KEY=

# --- Google Gemini (Gemini Pro/Flash for Aider) ---
GEMINI_API_KEY=

# --- Aider Default Configuration ---
# Options: sonnet, deepseek, 4o, gemini
AIDER_DEFAULT_MODEL=sonnet
